# Server Configuration
PORT=8000
NODE_ENV=development

# Authentication
TOKEN_SECRET_KEY=your_jwt_secret_key_here

# Database
CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster.mongodb.net/JobNest?retryWrites=true&w=majority

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI / LLM APIs for Resume RAG Auto-Fill (Optional: add either OpenAI or Gemini)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
